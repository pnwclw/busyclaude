{
  "description": "Shows Claude Code's prompts, questions and finished turns on a BUSY Bar, and brings back the answer.",
  "hooks": {
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/busyclaude.py\" hook --plugin",
            "timeout": 10
          }
        ]
      }
    ],
